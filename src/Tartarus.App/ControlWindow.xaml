<Window x:Class="Tartarus.App.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tartarus Solver" Width="520" SizeToContent="Height" MinHeight="300"
        Topmost="True" ResizeMode="CanMinimize" FontFamily="Segoe UI" FontSize="12"
        Background="#1E1F24" Foreground="#E8E8EC">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8E8EC" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9AA0AC" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style x:Key="LabelBox" TargetType="TextBox">
      <Setter Property="Margin" Value="4,1,10,1" />
      <Setter Property="MinWidth" Value="40" />
    </Style>
  </Window.Resources>
  <StackPanel Margin="10">
    <!-- Target window and capture -->
    <TextBlock Style="{StaticResource Section}" Margin="0,0,0,4" Text="游戏窗口" />
    <DockPanel>
      <Button x:Name="RefreshButton" DockPanel.Dock="Right" Margin="6,0,0,0" Content="⟳" ToolTip="刷新窗口列表" Click="RefreshButton_Click" />
      <ComboBox x:Name="WindowCombo" />
    </DockPanel>
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
      <Button x:Name="CaptureButton" Content="开始捕获 ▶" Click="CaptureButton_Click" />
      <CheckBox x:Name="AutoAttachCheck" Content="自动连接游戏" IsChecked="True" />
    </StackPanel>
    <TextBlock x:Name="CaptureStatus" Margin="0,4,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" Text="未在捕获" />

    <!-- Scanning -->
    <TextBlock Style="{StaticResource Section}" Text="识别" />
    <StackPanel Orientation="Horizontal">
      <Button x:Name="ScanButton" Content="扫描" Click="ScanButton_Click" />
      <CheckBox x:Name="AutoScanCheck" Content="自动" Margin="0,0,4,0" Checked="AutoScanCheck_Changed" Unchecked="AutoScanCheck_Changed" />
      <Slider x:Name="IntervalSlider" Width="140" Minimum="0" Maximum="1" SmallChange="0.1" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.1" TickPlacement="BottomRight"
              ValueChanged="IntervalSlider_ValueChanged" ToolTip="两帧之间的间隔秒数；0：上一帧识别和提示完成后立即处理下一帧" />
      <TextBlock x:Name="IntervalText" Margin="6,0,0,0" Text="0.5 秒" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                ToolTip="游戏显示文字所用的语言，程序据此识别游戏文字。与本程序的界面语言无关。">
      <TextBlock Text="游戏语言" Margin="0,0,6,0" />
      <ComboBox x:Name="GameLanguageCombo" Width="230" />
      <CheckBox x:Name="GameLanguageAutoCheck" Content="自动检测" Margin="10,0,0,0"
                ToolTip="从游戏的设置文件读取语言；关闭后在列表中手动选择" />
    </StackPanel>
    <StackPanel x:Name="ViewPanel" Orientation="Horizontal" Margin="0,6,0,0">
      <CheckBox x:Name="OverlayCheck" Content="叠加层" Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed" />
      <CheckBox x:Name="BoxesCheck" Content="可交互区域" ToolTip="框出所有可点击的位置：格子、卡牌、按钮、刑具槽和绮彩槽、选择卡" Checked="BoxesCheck_Changed" Unchecked="BoxesCheck_Changed" />
      <CheckBox x:Name="TextCheck" Content="文字" ToolTip="在叠加层上显示 OCR 区域和识别出的文字" Checked="TextCheck_Changed" Unchecked="TextCheck_Changed" />
    </StackPanel>
    <TextBlock x:Name="ScanStatus" Margin="0,4,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" Text="—" />

    <!-- Move hints -->
    <StackPanel>
      <TextBlock Style="{StaticResource Section}" Text="提示" />
      <StackPanel x:Name="HintChecks" Orientation="Horizontal">
        <CheckBox x:Name="HintsCheck" Content="走法提示" Checked="HintsCheck_Changed" Unchecked="HintsCheck_Changed" />
        <CheckBox x:Name="HintsOnlyCheck" Content="仅显示提示" Margin="12,0,12,0" Checked="HintsOnlyCheck_Changed" Unchecked="HintsOnlyCheck_Changed" ToolTip="叠加层只显示走法框和提示行：不显示格子、刑具和绮彩" />
      </StackPanel>
      <DockPanel Margin="0,6,0,0">
        <TextBlock DockPanel.Dock="Left" Text="更快" Foreground="#9AA0AC" Margin="0,0,6,0" />
        <TextBlock DockPanel.Dock="Right" Text="更强" Foreground="#9AA0AC" Margin="6,0,0,0" />
        <Slider x:Name="HintSlider" Minimum="0" Maximum="6" IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="BottomRight" ValueChanged="HintSlider_ValueChanged" ToolTip="每步的模拟次数：越多计算越久，提示越强" />
      </DockPanel>
      <TextBlock x:Name="HintLevelText" Margin="0,2,0,0" TextWrapping="Wrap" Text="—" />
      <TextBlock x:Name="HintStatus" Margin="0,2,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" Text="—" />
    </StackPanel>

    <!-- The game's log -->
    <TextBlock Style="{StaticResource Section}" Text="游戏日志" />
    <StackPanel Orientation="Horizontal">
      <Button x:Name="PickLogButton" Content="选择…" ToolTip="手动选择 UE_game.log：游戏目录\UE_game\TorchLight\Saved\Logs" Click="PickLogButton_Click" />
      <Button x:Name="AutoLogButton" Content="自动" ToolTip="自动查找日志：在运行中的游戏旁、Steam 库和启动器设置中查找" Click="AutoLogButton_Click" />
    </StackPanel>
    <TextBlock x:Name="LogStatus" Margin="0,2,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" Text="—" />

    <!-- Statistics -->
    <TextBlock Style="{StaticResource Section}" Text="统计" />
    <DockPanel>
      <Button x:Name="ResetStatsButton" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" Content="重置" ToolTip="清空统计，从现在起重新计数" Click="ResetStatsButton_Click" />
      <TextBlock x:Name="StatsText" TextWrapping="Wrap" Text="—" />
    </DockPanel>

    <!-- Debugging (the command line's debug flag): labels, dataset, what was read, the log -->
    <StackPanel x:Name="DebugPanel">
      <TextBlock Style="{StaticResource Section}" Text="标注与数据集" />
      <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="EditCheck" Content="编辑模式" Checked="EditCheck_Changed" Unchecked="EditCheck_Changed" />
        <Button x:Name="SaveButton" Content="保存帧" Click="SaveButton_Click" />
        <CheckBox x:Name="AutoCollectCheck" Content="自动收集" Margin="6,0,0,0" ToolTip="棋盘识别结果变化时自动把帧存入数据集（需开启自动扫描）" Checked="AutoCollectCheck_Changed" Unchecked="AutoCollectCheck_Changed" />
      </StackPanel>
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="典狱长" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="WardenBox" Style="{StaticResource LabelBox}" ToolTip="典狱长所在格，1-16" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="剩余天数" />
        <TextBox Grid.Row="0" Grid.Column="3" x:Name="DaysBox" Style="{StaticResource LabelBox}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="目的地" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DestinationsBox" Style="{StaticResource LabelBox}" ToolTip="目的地卡上的格子，从左到右：9,11,12" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="绮彩" />
        <TextBox Grid.Row="1" Grid.Column="3" x:Name="ChromaticBox" Style="{StaticResource LabelBox}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="刑具" />
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="InstrumentsBox" Style="{StaticResource LabelBox}" ToolTip="id，逗号分隔：ironbox,muzzle" />
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <Button x:Name="ApplyLabelsButton" Content="应用字段" Click="ApplyLabelsButton_Click" />
        <Button x:Name="ResetLabelsButton" Content="撤销编辑" Click="ResetLabelsButton_Click" />
        <Button x:Name="OpenDatasetButton" Content="数据集文件夹" Click="OpenDatasetButton_Click" />
      </StackPanel>
      <TextBlock x:Name="DatasetStatus" Margin="0,4,0,0" Foreground="#9AA0AC" TextWrapping="Wrap" />
      <TextBlock Margin="0,4,0,0" Foreground="#6F7580" TextWrapping="Wrap"
                 Text="编辑模式下在叠加层上点击格子：弹出代号、稀有度和标记菜单。编辑时自动扫描暂停。" />

      <!-- Sandbox summary and log -->
      <TextBlock Style="{StaticResource Section}" Text="棋盘" />
      <TextBox x:Name="SandboxSummary" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
               Background="#15161A" Foreground="#D8D8DC" BorderThickness="0" MinHeight="48" />
      <TextBlock Style="{StaticResource Section}" Text="日志" />
      <ListBox x:Name="LogList" Height="120" FontFamily="Consolas" FontSize="11" Background="#15161A" Foreground="#C8C8CC" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
    <DockPanel x:Name="UpdatePanel" Margin="0,8,0,0">
      <Button x:Name="UpdateButton" DockPanel.Dock="Right" Margin="6,0,0,0" Visibility="Collapsed" Click="UpdateButton_Click" />
      <CheckBox x:Name="UpdateCheck" Content="检查更新" ToolTip="启动时及每 6 小时向 GitHub 查询新版本" Checked="UpdateCheck_Changed" Unchecked="UpdateCheck_Changed" />
    </DockPanel>
    <DockPanel Margin="0,8,0,0">
      <Button x:Name="ReportButton" DockPanel.Dock="Right" Margin="6,0,0,0" Content="报告问题" ToolTip="把截图、程序日志和本局游戏日志连同你的说明发送给开发者" Click="ReportButton_Click" />
      <TextBlock x:Name="VersionText" Foreground="#6F7580" TextWrapping="Wrap" Text="版本" />
    </DockPanel>
  </StackPanel>
</Window>
