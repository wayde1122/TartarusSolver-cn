<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF shell: click-through overlay over the game + small control window. JIT (WPF). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WinTfm)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- .NET 9's CET-enabled apphost aborts before Main on older Windows 10 builds
         without special user-mode APC support. Keep the launcher compatible with our Windows 10 minimum. -->
    <CetCompat>false</CetCompat>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gugugaga.ico</ApplicationIcon>
    <AssemblyName>TartarusSolver</AssemblyName>
    <RootNamespace>Tartarus.App</RootNamespace>
    <!-- Where bug reports go (BugReports.DefaultDsn): kept out of the source, passed at build time. -->
    <SentryDsn Condition="'$(SentryDsn)' == ''">$(TARTARUS_SENTRY_DSN)</SentryDsn>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="SentryDsn" Value="$(SentryDsn)" />
    <Resource Include="Assets\gugugaga.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tartarus.Vision\Tartarus.Vision.csproj" />
    <ProjectReference Include="..\Tartarus.Solver\Tartarus.Solver.csproj" />
    <ProjectReference Include="..\Tartarus.Capture\Tartarus.Capture.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\AppFiles.cs" Link="AppFiles.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
    <PackageReference Include="Sentry" Version="6.12.1" />
  </ItemGroup>
</Project>
